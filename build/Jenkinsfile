pipeline {
    agent { label 'ec2' }

    environment {
        TERRAFORM_DIR = './deploy/terraformscripts'
        ANSIBLE_DIR   = './deploy/playbooks'
    }

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {
        stage('Prepare Tools') {
            steps {
                                echo 'Ensure ansible and terraform are available on the agent (will install terraform if missing)'
                                sh '''#!/bin/bash -l
                                set -e
                                # Install Terraform if missing
                                if ! command -v terraform >/dev/null 2>&1; then
                                    echo "Terraform not found, installing..."
                                    TF_VERSION=1.6.0
                                    TF_ZIP="terraform_${TF_VERSION}_linux_amd64.zip"
                                    if [ ! -f "${TF_ZIP}" ]; then
                                        wget "https://releases.hashicorp.com/terraform/${TF_VERSION}/${TF_ZIP}"
                                    fi
                                    unzip -o "${TF_ZIP}"
                                    sudo mv -f terraform /usr/local/bin/terraform
                                    rm -f "${TF_ZIP}"
                                else
                                    echo "Terraform already installed: $(terraform --version | head -n1)"
                                fi

                                # Ensure ansible is present (best-effort installation)
                                if ! command -v ansible-playbook >/dev/null 2>&1; then
                                    echo "Ansible not found, attempting to install..."
                                    if command -v yum >/dev/null 2>&1; then
                                        sudo yum install -y ansible || echo 'yum install ansible failed'
                                    elif command -v apt-get >/dev/null 2>&1; then
                                        sudo apt-get update || true
                                        sudo apt-get install -y ansible || echo 'apt-get install ansible failed'
                                    else
                                        echo 'No supported package manager found to install ansible automatically.'
                                    fi
                                else
                                    echo "Ansible already installed: $(ansible --version | head -n1)"
                                fi

                                terraform --version || true
                                ansible --version || true
                                '''
            }
        }

        stage('Terraform: Init & Validate') {
            steps {
                dir("${TERRAFORM_DIR}") {
                    sh 'terraform init -input=false'
                    sh 'terraform fmt -check || terraform fmt'
                    sh 'terraform validate || true'
                }
            }
        }

        stage('Terraform: Plan & Apply') {
            steps {
                dir("${TERRAFORM_DIR}") {
                    withEnv(["TF_IN_AUTOMATION=1"]) {
                        sh 'terraform plan -out=tfplan -input=false || true'
                        sh 'terraform apply -input=false -auto-approve tfplan'
                    }
                }
            }
        }

        stage('Sync Inventory') {
            steps {
                dir("${TERRAFORM_DIR}") {
                    script {
                        if (fileExists('inventory')) {
                            sh 'cp inventory ../playbooks/inventory'
                            echo 'Inventory copied to playbooks'
                        } else {
                            echo 'No inventory found in terraform dir; skipping copy.'
                        }
                    }
                }
            }
        }

        stage('Configure Kubernetes') {
            steps {
                dir("${ANSIBLE_DIR}") {
                    withCredentials([file(credentialsId: 'ssh-private-key', variable: 'SSH_KEY')]) {
                                                sh 'cp ${SSH_KEY} ./mykey && chmod 400 mykey'
                                                // normalize line endings and remove BOM (if any) to reduce format issues
                                                sh '''#!/bin/bash -l
                                                set -e
                                                # remove BOM if present and convert CRLF to LF
                                                sed -i '1s/^\xEF\xBB\xBF//' ./mykey || true
                                                if grep -q $'\r' ./mykey; then
                                                    echo 'Converting CRLF to LF in SSH key'
                                                    tr -d '\r' < ./mykey > ./mykey.tmp && mv ./mykey.tmp ./mykey
                                                    chmod 400 ./mykey
                                                fi

                                                # quick non-secret inspection: print the key header
                                                echo "SSH key header: $(head -n1 ./mykey | sed -E 's/(.{40}).*/\1.../')"

                                                # validate the SSH private key can be parsed by ssh-keygen (fail early with descriptive error)
                                                if ! ssh-keygen -y -f ./mykey > /dev/null 2>&1; then
                                                    echo 'ERROR: SSH private key at ./mykey is invalid or in unsupported format for OpenSSH/libcrypto.'
                                                    echo 'Make sure your Jenkins Secret File contains a proper PEM/OpenSSH private key (not a public key).' >&2
                                                    echo 'Printed key header above for debugging (non-secret truncated).' >&2
                                                    exit 2
                                                fi
                                                '''
                                                sh 'ansible-playbook -i inventory rhel_common.yaml'
                        sh 'ansible-playbook -i inventory rhel_master.yaml'
                    }
                }
            }
        }

        stage('Deploy & Monitoring (parallel)') {
            parallel {
                stage('Monitoring') {
                    steps {
                        dir("${ANSIBLE_DIR}") {
                            sh 'ansible-playbook -i inventory prometheus-grafana.yml'
                        }
                    }
                }
                stage('Application Deploy') {
                    steps {
                        dir("${ANSIBLE_DIR}") {
                            sh 'ansible-playbook -i inventory deployDeployment.yml'
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished'
            archiveArtifacts artifacts: 'deploy/terraformscripts/*.tfstate, deploy/terraformscripts/inventory', allowEmptyArchive: true
        }
    }
}
